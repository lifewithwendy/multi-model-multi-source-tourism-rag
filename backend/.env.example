# Get this from your Neon project dashboard -> Connection Details
# Format: postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for LLM generation. 
# Default is llama-3.3-70b-versatile. If you hit rate limits on the free tier, switch to llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Local path where Chroma persists its data
CHROMA_PERSIST_DIR=./chroma_data

# Which embedding provider to use: 'local' (sentence-transformers) or 'jina' (Jina AI API)
EMBEDDING_PROVIDER=local

# Required if EMBEDDING_PROVIDER=jina. Get a free key at https://jina.ai/embeddings
JINA_API_KEY=your_jina_api_key_here

# Disable ChromaDB telemetry warnings
ANONYMIZED_TELEMETRY=False
